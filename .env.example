# PostgreSQL connection string (Neon, Supabase, local Docker...)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/booking

# Signs the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Staff login
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me

# Show the admin credentials on the login page (public demo only)
DEMO_MODE=false
